DATABASE_URL="postgresql://destinlmincy:destinlmincy_dev_password@127.0.0.1:5434/destinlmincy_dev?schema=public"
POSTGRES_DB="destinlmincy_dev"
POSTGRES_USER="destinlmincy"
POSTGRES_PASSWORD="destinlmincy_dev_password"

# Clerk (development instance keys; see https://dashboard.clerk.com)
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Comma-separated, case-insensitive allowlist of emails granted /admin access.
ADMIN_EMAILS=admin@example.com

# DocuSign (Unit 08 - required for contract signing)
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_ACCOUNT_ID=
# RSA private key content (not path) - newlines escaped as \n
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_IMPERSONATED_USER_ID=
DOCUSIGN_OAUTH_BASE_PATH=account-d.docusign.com
DOCUSIGN_ADMIN_EMAIL=admin@example.com
DOCUSIGN_ADMIN_NAME=Destin Mincy
# Public-facing URL for DocuSign webhook callbacks
NEXT_PUBLIC_APP_URL=https://destinlmincy.com

# Stripe (Unit 09 - optional until payment API is implemented)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AWS S3 - contract PDF storage (Unit 07 - optional until PDF generation is implemented)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_PRIVATE_BUCKET=
