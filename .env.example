# ============================================
# Portfolio Website - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ============================================
# Application Configuration
# ============================================
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Destin L. Mincy Portfolio

# ============================================
# Supabase (Database & Authentication)
# ============================================
# Get these from your Supabase project settings: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_DB_URL=your-supabase-database-url

# ============================================
# OAuth Providers (Supabase Auth)
# ============================================
# Configure in Supabase Dashboard > Authentication > Providers
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook OAuth
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# GitHub OAuth (Optional)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ============================================
# Stripe (Payment Processing)
# ============================================
# Get from Stripe Dashboard > Developers > API keys: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_LINK_ENABLED=true
# For production, use pk_live_ and sk_live_ prefixes

# ============================================
# OpenAI (Nora AI Chat Widget)
# ============================================
# Get from OpenAI Platform: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
NORA_GUEST_MODEL=gpt-3.5-turbo
NORA_AUTHENTICATED_MODEL=gpt-4-turbo-preview
NORA_TEMPERATURE=0.7
NORA_MAX_TOKENS=1000
NORA_SYSTEM_MESSAGE_PATH=./config/nora-system-message.txt

# ============================================
# Google Calendar API (Booking System)
# ============================================
# Get from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CALENDAR_CLIENT_ID=your-google-calendar-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=your-google-calendar-client-secret
GOOGLE_CALENDAR_REFRESH_TOKEN=your-refresh-token
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/auth/google-calendar/callback
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_SERVICE_ACCOUNT_EMAIL=your-service-account-email
GOOGLE_CALENDAR_SERVICE_ACCOUNT_KEY=your-service-account-json-key
# Optional: Use service account JSON file path instead
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./path/to/service-account-key.json

# ============================================
# DocuSign (Contract Management)
# ============================================
# Get from DocuSign Developer Account: https://developers.docusign.com
DOCUSIGN_INTEGRATION_KEY=your-docusign-integration-key
DOCUSIGN_USER_ID=your-docusign-user-id
DOCUSIGN_ACCOUNT_ID=your-docusign-account-id
DOCUSIGN_CLIENT_ID=your-docusign-client-id
DOCUSIGN_CLIENT_SECRET=your-docusign-client-secret
DOCUSIGN_RSA_PRIVATE_KEY=your-docusign-rsa-private-key
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi
DOCUSIGN_OAUTH_BASE_PATH=https://account-d.docusign.com
# For production: https://www.docusign.net/restapi

# ============================================
# n8n (Automation Workflows)
# ============================================
# Webhook URLs for different automation workflows
# AI Contract Generation (n8n AI Agent workflow)
N8N_WEBHOOK_CONTRACT_GENERATION=https://your-n8n-instance.com/webhook/contract-generation

# Booking automation (meeting booking from UI or Nora)
N8N_WEBHOOK_BOOKING=https://your-n8n-instance.com/webhook/booking

# Contact form automation (optional - for contact form submissions)
N8N_WEBHOOK_CONTACT=https://your-n8n-instance.com/webhook/contact

# General automation webhook (for pushing information to start workflows)
N8N_WEBHOOK_GENERAL=https://your-n8n-instance.com/webhook/general

# n8n API key (if needed for authentication)
N8N_API_KEY=your-n8n-api-key-here

# ============================================
# NextAuth.js (If using NextAuth)
# ============================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here
# Generate with: openssl rand -base64 32

# ============================================
# Security & Session
# ============================================
SESSION_SECRET=your-session-secret-here
# Generate with: openssl rand -base64 32

# ============================================
# Analytics (Optional)
# ============================================
# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Vercel Analytics (if using Vercel)
# Automatically configured when deployed to Vercel

# ============================================
# Google Ads (Marketing & Conversion Tracking)
# ============================================
# Get from Google Ads account: https://ads.google.com
# Google Ads Conversion ID (for conversion tracking)
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=AW-XXXXXXXXXX

# Google Ads Conversion Label (for specific conversion actions)
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=your-conversion-label

# Google Ads Customer ID (for remarketing)
NEXT_PUBLIC_GOOGLE_ADS_CUSTOMER_ID=123-456-7890

# Google Tag Manager Container ID (optional - if using GTM)
NEXT_PUBLIC_GTM_CONTAINER_ID=GTM-XXXXXXX
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXX
# Google Ads ID (for conversion tracking)
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX

# Google Ads API (for programmatic access - optional)
GOOGLE_ADS_CLIENT_ID=your-google-ads-client-id
GOOGLE_ADS_CLIENT_SECRET=your-google-ads-client-secret
GOOGLE_ADS_REFRESH_TOKEN=your-google-ads-refresh-token
GOOGLE_ADS_DEVELOPER_TOKEN=your-google-ads-developer-token
GOOGLE_ADS_CUSTOMER_ID=123-456-7890

# ============================================
# Nora AI Chat Widget Configuration
# ============================================
# OpenAI Model Configuration
# Guest users model (cost-effective)
NEXT_PUBLIC_NORA_GUEST_MODEL=gpt-3.5-turbo
# Authenticated users model (function calling enabled)
NEXT_PUBLIC_NORA_AUTH_MODEL=gpt-4-turbo-preview
# Temperature (0.0-2.0, lower = more focused, higher = more creative)
NORA_TEMPERATURE=0.7
# Max tokens per response
NORA_MAX_TOKENS=1000
# Chat widget enabled/disabled
NEXT_PUBLIC_NORA_ENABLED=true
# Chat widget position (bottom-right, bottom-left, top-right, top-left)
NEXT_PUBLIC_NORA_POSITION=bottom-right
# Show widget on all pages (true) or specific pages only (false)
NEXT_PUBLIC_NORA_SHOW_ON_ALL_PAGES=true
# Welcome message (shown when chat opens)
NEXT_PUBLIC_NORA_WELCOME_MESSAGE=Hello World!

# ============================================
# Booking System Defaults
# ============================================
# Default meeting duration in minutes (e.g., 30, 60)
BOOKING_DEFAULT_DURATION=60
BOOKING_BUFFER_MINUTES=15
# Default buffer time between meetings in minutes
BOOKING_DEFAULT_BUFFER_TIME=15
# Minimum advance booking time in hours (e.g., 24 = must book 24 hours in advance)
BOOKING_MIN_ADVANCE_HOURS=24
# Maximum advance booking time in days (e.g., 90 = can book up to 90 days ahead)
BOOKING_MAX_ADVANCE_DAYS=90
# Default timezone (e.g., America/New_York, UTC)
BOOKING_DEFAULT_TIMEZONE=America/New_York
BOOKING_TIMEZONE=America/New_York
# Available meeting duration options (comma-separated, in minutes)
NEXT_PUBLIC_BOOKING_DURATION_OPTIONS=30,60,90
# Booking system enabled/disabled
NEXT_PUBLIC_BOOKING_ENABLED=true
# Video call integration
BOOKING_VIDEO_CALL_ENABLED=true
BOOKING_ZOOM_API_KEY=your-zoom-api-key
BOOKING_ZOOM_API_SECRET=your-zoom-api-secret
BOOKING_GOOGLE_MEET_ENABLED=true

# ============================================
# Payment/Invoice Settings
# ============================================
# Currency code (USD, EUR, GBP, etc.)
NEXT_PUBLIC_PAYMENT_CURRENCY=USD
INVOICE_DEFAULT_CURRENCY=USD
# Tax rate as decimal (e.g., 0.08 for 8%)
PAYMENT_TAX_RATE=0.00
INVOICE_DEFAULT_TAX_RATE=0
# Invoice numbering
INVOICE_NUMBER_FORMAT=INV-YYYY-###
INVOICE_NUMBER_PREFIX=INV-
INVOICE_NUMBER_RESET=yearly
# Default payment terms (e.g., Net 30, Net 15, Due on Receipt)
INVOICE_DEFAULT_PAYMENT_TERMS=Net 30
# Default invoice due date (days from invoice date)
INVOICE_DEFAULT_DUE_DAYS=30
INVOICE_DUE_DAYS=30
# Invoice reminders (days before due date, comma-separated)
INVOICE_REMINDER_DAYS=7,3,1
# Overdue invoice threshold (days)
INVOICE_OVERDUE_DAYS=7
# Stripe Link enabled/disabled
NEXT_PUBLIC_STRIPE_LINK_ENABLED=true

# Payment Plan Configuration
PAYMENT_PLAN_MIN_INSTALLMENTS=2
PAYMENT_PLAN_MAX_INSTALLMENTS=12
PAYMENT_PLAN_DEFAULT_FREQUENCY=monthly

# Tax Configuration
TAX_ENABLED=true
TAX_DEFAULT_RATE=0
TAX_CALCULATION_METHOD=line_item

# Multi-Currency Configuration
MULTI_CURRENCY_ENABLED=false
CURRENCY_CONVERSION_API_KEY=your-currency-api-key
CURRENCY_CONVERSION_API_URL=https://api.exchangerate-api.com/v4/latest
CURRENCY_UPDATE_FREQUENCY=daily

# ============================================
# Site Configuration
# ============================================
# Site name
NEXT_PUBLIC_SITE_NAME=SiteNAME
# Site title (for SEO)
NEXT_PUBLIC_SITE_TITLE=Snazzy Title
# Site description (for SEO)
NEXT_PUBLIC_SITE_DESCRIPTION=professional portfolio
# Site email (for contact forms, notifications)
SITE_EMAIL=your@email.com
# Support email (for customer support)
SUPPORT_EMAIL=your@email.com
# Company name
NEXT_PUBLIC_COMPANY_NAME=SomeCompany
# Company address (optional)
NEXT_PUBLIC_COMPANY_ADDRESS=
# Company phone (optional)
NEXT_PUBLIC_COMPANY_PHONE=

# ============================================
# Site Configuration (Additional)
# ============================================
SITE_NAME=Destin L. Mincy
SITE_PHONE=+1-XXX-XXX-XXXX
SITE_ADDRESS=Your Address
SITE_CITY=Your City
SITE_STATE=Your State
SITE_ZIP=Your ZIP
SITE_COUNTRY=United States

# ============================================
# Social Media Links (Optional)
# ============================================
SOCIAL_LINKEDIN=https://linkedin.com/in/destinlmincy
SOCIAL_GITHUB=https://github.com/destinlmincy
SOCIAL_TWITTER=https://twitter.com/destinlmincy

# ============================================
# Security & Rate Limiting
# ============================================
# Rate Limiting
RATE_LIMIT_ENABLED=true
# API rate limit (requests per minute per IP)
API_RATE_LIMIT=60
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000

# Session Configuration
# Session timeout in minutes
SESSION_TIMEOUT_MINUTES=60
SESSION_TIMEOUT_MS=3600000
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=strict

# CORS allowed origins (comma-separated, or * for all)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Password Configuration
# Password minimum length
PASSWORD_MIN_LENGTH=8
# Require password complexity (uppercase, lowercase, number, special char)
PASSWORD_REQUIRE_COMPLEXITY=true

# 2FA Configuration
TWO_FACTOR_ENABLED=true
TWO_FACTOR_ENFORCE_ADMIN=true
TWO_FACTOR_ENFORCE_CUSTOMER=false
TWO_FACTOR_ISSUER=Destin L. Mincy Portfolio

# SMS 2FA (Optional - Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# IP Whitelisting (Admin)
ADMIN_IP_WHITELIST_ENABLED=false
ADMIN_IP_WHITELIST=127.0.0.1,::1

# Account Lockout
ACCOUNT_LOCKOUT_ENABLED=true
ACCOUNT_LOCKOUT_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MS=1800000

# ============================================
# Media/File Upload Settings
# ============================================
# Max file size in MB
UPLOAD_MAX_FILE_SIZE_MB=10
MAX_FILE_SIZE_MB=10
# Allowed file types/extensions (comma-separated)
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp,pdf,doc,docx
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf
# Storage provider (supabase or aws-s3)
UPLOAD_STORAGE_PROVIDER=supabase
# Supabase storage bucket name for uploads
SUPABASE_STORAGE_BUCKET=media
# Supabase storage bucket for public assets
SUPABASE_STORAGE_PUBLIC_BUCKET=public

# Alternative: AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name

# ============================================
# Contact Form Settings
# ============================================
# Contact form enabled/disabled
NEXT_PUBLIC_CONTACT_FORM_ENABLED=true
# Contact form email destination
CONTACT_FORM_EMAIL=your@email.com
# Spam detection enabled/disabled
CONTACT_FORM_SPAM_DETECTION_ENABLED=true
# Spam detection threshold (0.0-1.0, higher = more strict)
CONTACT_FORM_SPAM_THRESHOLD=0.7
# Auto-response enabled/disabled
CONTACT_FORM_AUTO_RESPONSE_ENABLED=true
# Auto-response subject
CONTACT_FORM_AUTO_RESPONSE_SUBJECT=Thank you for contacting us

# ============================================
# Email Configuration
# ============================================
# Email will typically be handled by n8n automation workflows. 
# This is just a fallback for local development.

# Option 1: SMTP (via Supabase or custom SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-email-password
# SMTP_FROM_EMAIL=noreply@your-email.com
# SMTP_FROM_NAME=your name

# Option 2: Email Service (Resend, SendGrid, etc.)
# RESEND_API_KEY=your-resend-api-key
# SENDGRID_API_KEY=your-sendgrid-api-key

# Email Queue Configuration
# EMAIL_QUEUE_ENABLED=true
# EMAIL_QUEUE_BATCH_SIZE=50
# EMAIL_QUEUE_RETRY_ATTEMPTS=3
# EMAIL_QUEUE_RETRY_DELAY=30000

# ============================================
# GDPR & Compliance
# ============================================
GDPR_ENABLED=true
PRIVACY_POLICY_URL=https://destinlmincy.com/privacy
TERMS_OF_SERVICE_URL=https://destinlmincy.com/terms
COOKIE_CONSENT_ENABLED=true
DATA_RETENTION_DAYS=365

# ============================================
# Caching Configuration
# ============================================
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
REDIS_URL=redis://localhost:6379
# Alternative: Upstash Redis
UPSTASH_REDIS_REST_URL=your-upstash-redis-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# ============================================
# Logging & Monitoring
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json
SENTRY_DSN=your-sentry-dsn
SENTRY_ENVIRONMENT=development

# ============================================
# Feature Flags (Enhanced)
# ============================================
# Enable/disable major features
NEXT_PUBLIC_BLOG_ENABLED=false
FEATURE_BLOG_ENABLED=false
NEXT_PUBLIC_MAINTENANCE_MODE=false
NEXT_PUBLIC_CUSTOMER_PORTAL_ENABLED=true
NEXT_PUBLIC_BOOKING_ENABLED=true
NEXT_PUBLIC_NORA_ENABLED=true
NEXT_PUBLIC_CONTACT_FORM_ENABLED=true

# New Feature Flags
FEATURE_DARK_MODE_ENABLED=true
FEATURE_GLOBAL_SEARCH_ENABLED=true
FEATURE_NOTIFICATIONS_ENABLED=true
FEATURE_MESSAGING_ENABLED=true
FEATURE_RECURRING_INVOICES_ENABLED=true
FEATURE_PAYMENT_PLANS_ENABLED=true
FEATURE_DISCOUNT_CODES_ENABLED=true
FEATURE_CREDIT_NOTES_ENABLED=true
FEATURE_MULTI_CURRENCY_ENABLED=false
FEATURE_EXPORT_ENABLED=true
FEATURE_BULK_OPERATIONS_ENABLED=true
FEATURE_API_ACCESS_ENABLED=false

# ============================================
# Development/Testing
# ============================================
# Test database (if using separate test instance)
TEST_SUPABASE_URL=https://your-test-project.supabase.co
TEST_SUPABASE_ANON_KEY=your-test-anon-key
TEST_SUPABASE_SERVICE_ROLE_KEY=your-test-service-role-key

# Test Stripe Keys
TEST_STRIPE_PUBLISHABLE_KEY=pk_test_...
TEST_STRIPE_SECRET_KEY=sk_test_...
TEST_STRIPE_WEBHOOK_SECRET=whsec_test_...
# Note: Stripe test mode keys are already included above with pk_test_/sk_test_ prefixes
