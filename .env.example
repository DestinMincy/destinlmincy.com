# destinlmincy.com environment template.
#
# Copy this file to BOTH .env and .env.local:
#   .env        is read by the Prisma CLI (prisma.config.ts) and docker compose.
#   .env.local  is read by Next.js (npm run dev, build, start).
# Every value here is a placeholder. Never commit real keys.
# What each variable does, where to get it, and the local default:
# docs/environment.md

# --- Postgres ---------------------------------------------------------------
# Feature: all data (admin, portal, contracts), migrations, seed, integration tests.
# REQUIRED. The default points at the docker compose container on port 5434.
DATABASE_URL="postgresql://destinlmincy:destinlmincy_dev_password@127.0.0.1:5434/destinlmincy_dev?schema=public"

# Feature: the local docker compose Postgres container (docker-compose.yml).
# REQUIRED locally only, and must match DATABASE_URL. Not used in production.
POSTGRES_DB="destinlmincy_dev"
POSTGRES_USER="destinlmincy"
POSTGRES_PASSWORD="destinlmincy_dev_password"

# --- Clerk ------------------------------------------------------------------
# Feature: sign-in, /admin and /portal access, portal subscription entitlements.
# REQUIRED. Keys come from the Clerk dashboard (API keys page).
# The publishable key below is a format-valid placeholder so `next build`
# passes; replace both keys before signing in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_ZXhhbXBsZS5jbGVyay5hY2NvdW50cy5kZXYk
CLERK_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Admin allowlist --------------------------------------------------------
# Feature: /admin. Comma-separated, case-insensitive verified Clerk emails.
# REQUIRED to use /admin (everyone else gets a 404 there).
ADMIN_EMAILS=admin@example.com

# --- AWS S3 (private contract PDF bucket) -----------------------------------
# Feature: contract generation (stores the generated PDF), DocuSign send
# (reads it back), and the DocuSign webhook (stores the signed PDF).
# REQUIRED for contracts. Without them, generation and completion refuse to run.
AWS_REGION=us-east-1
S3_PRIVATE_BUCKET=

# Feature: credentials for the bucket above, read by the AWS SDK.
# OPTIONAL: leave empty on EC2 with an instance role or with an AWS profile;
# set them locally when nothing else provides credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- DocuSign ---------------------------------------------------------------
# Feature: sending a contract for signature and downloading the signed PDF.
# REQUIRED for DocuSign. Values come from the DocuSign Apps and Keys page.
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_IMPERSONATED_USER_ID=
# RSA private key content (not a path), newlines written as \n, in quotes.
DOCUSIGN_PRIVATE_KEY=
# account-d.docusign.com for the sandbox, account.docusign.com for production.
DOCUSIGN_OAUTH_BASE_PATH=account-d.docusign.com

# Feature: the admin countersigner on every envelope.
# REQUIRED for DocuSign send. DOCUSIGN_ADMIN_NAME is optional (defaults to "Admin").
DOCUSIGN_ADMIN_EMAIL=admin@example.com
DOCUSIGN_ADMIN_NAME=Destin Mincy

# Feature: public base URL of this app. Builds the DocuSign Connect webhook
# URL and the JWT consent redirect. REQUIRED for DocuSign send.
# Must be publicly reachable for webhooks (a tunnel URL when testing locally).
# Inlined at build time: rebuild after changing it.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature: DocuSign Connect webhook signature check (/api/webhooks/docusign).
# REQUIRED for DocuSign completion. The webhook rejects every notification
# with 401 while this is empty.
DOCUSIGN_CONNECT_HMAC_KEY=

# --- Stripe -----------------------------------------------------------------
# No variables. v1 attaches Stripe invoice and payment-link URLs to payment
# gates by hand, and no code calls the Stripe API. See docs/environment.md.
