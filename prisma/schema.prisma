generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ClientRelationshipLifecycle {
  LEAD
  DISCOVERY
  PROPOSAL
  CONTRACTED
  AWAITING_PAYMENT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ContractTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PaymentGateStatus {
  PENDING
  ATTACHED
  PAID
  WAIVED
}

enum SubscriptionServiceType {
  HOSTING
  MAINTENANCE
}

enum SubscriptionReferenceStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  PAUSED
  OVERRIDDEN
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  BLOCKED
  COMPLETE
}

enum ClientUserStatus {
  ACTIVE
  REMOVED
}

enum ApplicationSiteType {
  WEBSITE
  WEB_APPLICATION
  INTERNAL_TOOL
  OTHER
}

enum ApplicationSiteStatus {
  ACTIVE
  ARCHIVED
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  PAUSED
  COMPLETED
  ARCHIVED
}

model ClientRelationship {
  id                  String                      @id @default(cuid())
  name                String
  slug                String                      @unique
  lifecycle           ClientRelationshipLifecycle @default(LEAD)
  legalName           String?
  primaryContactName  String?
  primaryContactEmail String?
  primaryContactPhone String?
  summary             String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  users             ClientUser[]
  applications      ApplicationSite[]
  projects          Project[]
  contractTemplates ContractTemplate[]
  paymentGates      PaymentGate[]
  subscriptions     SubscriptionReference[]
  milestones        Milestone[]
  deliverables      Deliverable[]

  @@map("client_relationships")
}

model ClientUser {
  id                   String           @id @default(cuid())
  clientRelationshipId String
  clerkUserId          String
  email                String
  name                 String?
  status               ClientUserStatus @default(ACTIVE)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  clientRelationship ClientRelationship @relation(fields: [clientRelationshipId], references: [id], onDelete: Cascade)

  @@unique([clientRelationshipId, clerkUserId])
  @@index([clerkUserId])
  @@map("client_users")
}

model ApplicationSite {
  id                   String                @id @default(cuid())
  clientRelationshipId String
  name                 String
  type                 ApplicationSiteType   @default(WEBSITE)
  status               ApplicationSiteStatus @default(ACTIVE)
  productionUrl        String?
  stagingUrl           String?
  repositoryUrl        String?
  notes                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  clientRelationship ClientRelationship      @relation(fields: [clientRelationshipId], references: [id], onDelete: Cascade)
  projects           Project[]
  subscriptions      SubscriptionReference[]

  @@unique([id, clientRelationshipId])
  @@index([clientRelationshipId])
  @@map("application_sites")
}

model Project {
  id                   String        @id @default(cuid())
  clientRelationshipId String
  applicationSiteId    String?
  name                 String
  status               ProjectStatus @default(PLANNED)
  summary              String?
  clientDescription    String?
  createsNewAsset      Boolean       @default(false)
  startsAt             DateTime?
  targetDate           DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  clientRelationship ClientRelationship      @relation(fields: [clientRelationshipId], references: [id], onDelete: Cascade)
  applicationSite    ApplicationSite?        @relation(fields: [applicationSiteId, clientRelationshipId], references: [id, clientRelationshipId], onDelete: Restrict)
  paymentGates       PaymentGate[]
  subscriptions      SubscriptionReference[]
  milestones         Milestone[]
  deliverables       Deliverable[]

  @@unique([id, clientRelationshipId])
  @@index([clientRelationshipId])
  @@index([applicationSiteId])
  @@map("projects")
}

model ContractTemplate {
  id                   String                 @id @default(cuid())
  clientRelationshipId String
  name                 String
  status               ContractTemplateStatus @default(DRAFT)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  clientRelationship ClientRelationship        @relation(fields: [clientRelationshipId], references: [id], onDelete: Cascade)
  versions           ContractTemplateVersion[]

  @@index([clientRelationshipId])
  @@map("contract_templates")
}

model ContractTemplateVersion {
  id                 String    @id @default(cuid())
  contractTemplateId String
  versionNumber      Int
  snapshot           Json?
  publishedAt        DateTime?
  createdAt          DateTime  @default(now())

  contractTemplate ContractTemplate @relation(fields: [contractTemplateId], references: [id], onDelete: Cascade)

  @@unique([contractTemplateId, versionNumber])
  @@map("contract_template_versions")
}

model PaymentGate {
  id                   String            @id @default(cuid())
  clientRelationshipId String
  projectId            String?
  label                String
  status               PaymentGateStatus @default(PENDING)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  clientRelationship ClientRelationship @relation(fields: [clientRelationshipId], references: [id], onDelete: Cascade)
  project            Project?           @relation(fields: [projectId, clientRelationshipId], references: [id, clientRelationshipId], onDelete: Restrict)

  @@index([clientRelationshipId])
  @@index([projectId])
  @@map("payment_gates")
}

model SubscriptionReference {
  id                   String                      @id @default(cuid())
  clientRelationshipId String
  applicationSiteId    String?
  projectId            String?
  serviceType          SubscriptionServiceType
  status               SubscriptionReferenceStatus @default(ACTIVE)
  clerkSubscriptionId  String?
  entitlementKey       String?
  currentPeriodEndsAt  DateTime?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  clientRelationship ClientRelationship @relation(fields: [clientRelationshipId], references: [id], onDelete: Cascade)
  applicationSite    ApplicationSite?   @relation(fields: [applicationSiteId, clientRelationshipId], references: [id, clientRelationshipId], onDelete: Restrict)
  project            Project?           @relation(fields: [projectId, clientRelationshipId], references: [id, clientRelationshipId], onDelete: Restrict)

  @@index([clientRelationshipId])
  @@index([applicationSiteId])
  @@index([projectId])
  @@index([clerkSubscriptionId])
  @@map("subscription_references")
}

model Milestone {
  id                   String          @id @default(cuid())
  clientRelationshipId String
  projectId            String
  title                String
  status               MilestoneStatus @default(PLANNED)
  targetDate           DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  clientRelationship ClientRelationship @relation(fields: [clientRelationshipId], references: [id], onDelete: Cascade)
  project            Project            @relation(fields: [projectId, clientRelationshipId], references: [id, clientRelationshipId], onDelete: Cascade)
  deliverables       Deliverable[]

  @@unique([id, clientRelationshipId])
  @@index([clientRelationshipId])
  @@index([projectId])
  @@map("milestones")
}

model Deliverable {
  id                   String   @id @default(cuid())
  clientRelationshipId String
  projectId            String?
  milestoneId          String?
  label                String
  url                  String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  clientRelationship ClientRelationship @relation(fields: [clientRelationshipId], references: [id], onDelete: Cascade)
  project            Project?           @relation(fields: [projectId, clientRelationshipId], references: [id, clientRelationshipId], onDelete: Restrict)
  milestone          Milestone?         @relation(fields: [milestoneId, clientRelationshipId], references: [id, clientRelationshipId], onDelete: Restrict)

  @@index([clientRelationshipId])
  @@index([projectId])
  @@index([milestoneId])
  @@map("deliverables")
}
