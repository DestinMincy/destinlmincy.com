generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ClientRelationshipLifecycle {
  LEAD
  DISCOVERY
  PROPOSAL
  CONTRACTED
  AWAITING_PAYMENT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ContractTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PaymentGateStatus {
  PENDING
  ATTACHED
  PAID
  WAIVED
}

enum SubscriptionServiceType {
  HOSTING
  MAINTENANCE
}

enum SubscriptionReferenceStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  PAUSED
  OVERRIDDEN
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  BLOCKED
  COMPLETE
}

enum ClientUserStatus {
  ACTIVE
  REMOVED
}

enum ApplicationSiteType {
  WEBSITE
  WEB_APPLICATION
  INTERNAL_TOOL
  OTHER
}

enum ApplicationSiteStatus {
  ACTIVE
  ARCHIVED
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETE
  IN_PROGRESS
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ContractStatus {
  DRAFT
  GENERATED
  SENT_FOR_SIGNING
  CLIENT_SIGNED
  COMPLETE
  VOIDED
}

enum PaymentGateType {
  FULL_UPFRONT
  DEPOSIT
  MILESTONE_PAYMENT
  OTHER
}

enum MilestoneApprovalAction {
  APPROVED
  CHANGES_REQUESTED
}

enum DeliverableType {
  LINK
  DOCUMENT
  VIDEO
  OTHER
}

enum DeliverableVisibility {
  CLIENT
  ADMIN_ONLY
}

model ClientRelationship {
  id                  String                      @id @default(cuid())
  name                String
  slug                String                      @unique
  lifecycle           ClientRelationshipLifecycle @default(LEAD)
  legalName           String?
  primaryContactName  String?
  primaryContactEmail String?
  primaryContactPhone String?
  summary             String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  users             ClientUser[]
  applications      ApplicationSite[]
  projects          Project[]
  contractTemplates ContractTemplate[]
  paymentGates      PaymentGate[]
  subscriptions     SubscriptionReference[]
  milestones        Milestone[]
  deliverables      Deliverable[]
  contracts         Contract[]

  @@map("client_relationships")
}

model ClientUser {
  id                   String           @id @default(cuid())
  clientRelationshipId String
  clerkUserId          String
  email                String
  name                 String?
  status               ClientUserStatus @default(ACTIVE)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  clientRelationship ClientRelationship @relation(fields: [clientRelationshipId], references: [id], onDelete: Cascade)

  @@unique([clientRelationshipId, clerkUserId])
  @@index([clerkUserId])
  @@map("client_users")
}

model ApplicationSite {
  id                   String                @id @default(cuid())
  clientRelationshipId String
  name                 String
  type                 ApplicationSiteType   @default(WEBSITE)
  status               ApplicationSiteStatus @default(ACTIVE)
  productionUrl        String?
  stagingUrl           String?
  repositoryUrl        String?
  notes                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  archivedAt DateTime?

  clientRelationship ClientRelationship      @relation(fields: [clientRelationshipId], references: [id], onDelete: Cascade)
  projects           Project[]
  subscriptions      SubscriptionReference[]

  @@unique([id, clientRelationshipId])
  @@index([clientRelationshipId])
  @@map("application_sites")
}

model Project {
  id                   String        @id @default(cuid())
  clientRelationshipId String
  applicationSiteId    String?
  name                 String
  status               ProjectStatus @default(PLANNED)
  summary              String?
  clientDescription    String?
  createsNewAsset      Boolean       @default(false)
  startsAt             DateTime?
  targetDate           DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  startDate               DateTime?
  clientFacingDescription String?
  archivedAt              DateTime?

  clientRelationship ClientRelationship      @relation(fields: [clientRelationshipId], references: [id], onDelete: Cascade)
  applicationSite    ApplicationSite?        @relation(fields: [applicationSiteId, clientRelationshipId], references: [id, clientRelationshipId], onDelete: Restrict)
  paymentGates       PaymentGate[]
  subscriptions      SubscriptionReference[]
  milestones         Milestone[]
  deliverables       Deliverable[]

  @@unique([id, clientRelationshipId])
  @@index([clientRelationshipId])
  @@index([applicationSiteId])
  @@map("projects")
}

model ContractTemplate {
  id                   String                 @id @default(cuid())
  clientRelationshipId String
  name                 String
  status               ContractTemplateStatus @default(DRAFT)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  clientRelationship ClientRelationship        @relation(fields: [clientRelationshipId], references: [id], onDelete: Cascade)
  versions           ContractTemplateVersion[]

  @@index([clientRelationshipId])
  @@map("contract_templates")
}

model ContractTemplateVersion {
  id                 String    @id @default(cuid())
  contractTemplateId String
  versionNumber      Int
  snapshot           Json?
  blocks             Json?
  variables          Json?
  publishedAt        DateTime?
  archivedAt         DateTime?
  createdAt          DateTime  @default(now())

  contractTemplate   ContractTemplate @relation(fields: [contractTemplateId], references: [id], onDelete: Cascade)
  generatedContracts Contract[]

  @@unique([contractTemplateId, versionNumber])
  @@map("contract_template_versions")
}

model PaymentGate {
  id                   String            @id @default(cuid())
  clientRelationshipId String
  projectId            String?
  label                String
  status               PaymentGateStatus @default(PENDING)
  paymentType          PaymentGateType   @default(FULL_UPFRONT)
  amount               Decimal?          @db.Decimal(12, 2)
  currency             String            @default("USD")
  dueDate              DateTime?
  requiredBeforeWork   Boolean           @default(false)
  stripeUrl            String?
  stripeId             String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  clientRelationship ClientRelationship @relation(fields: [clientRelationshipId], references: [id], onDelete: Cascade)
  project            Project?           @relation(fields: [projectId, clientRelationshipId], references: [id, clientRelationshipId], onDelete: Restrict)

  @@index([clientRelationshipId])
  @@index([projectId])
  @@map("payment_gates")
}

model SubscriptionReference {
  id                   String                      @id @default(cuid())
  clientRelationshipId String
  applicationSiteId    String?
  projectId            String?
  serviceType          SubscriptionServiceType
  status               SubscriptionReferenceStatus @default(ACTIVE)
  clerkSubscriptionId  String?
  entitlementKey       String?
  currentPeriodEndsAt  DateTime?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  clientRelationship ClientRelationship @relation(fields: [clientRelationshipId], references: [id], onDelete: Cascade)
  applicationSite    ApplicationSite?   @relation(fields: [applicationSiteId, clientRelationshipId], references: [id, clientRelationshipId], onDelete: Restrict)
  project            Project?           @relation(fields: [projectId, clientRelationshipId], references: [id, clientRelationshipId], onDelete: Restrict)

  @@index([clientRelationshipId])
  @@index([applicationSiteId])
  @@index([projectId])
  @@index([clerkSubscriptionId])
  @@map("subscription_references")
}

model Milestone {
  id                   String          @id @default(cuid())
  clientRelationshipId String
  projectId            String
  title                String
  status               MilestoneStatus @default(PLANNED)
  targetDate           DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  clientFacingUpdate  String?
  paymentDependencyId String?
  approvalRequired    Boolean @default(false)

  clientRelationship ClientRelationship  @relation(fields: [clientRelationshipId], references: [id], onDelete: Cascade)
  project            Project             @relation(fields: [projectId, clientRelationshipId], references: [id, clientRelationshipId], onDelete: Cascade)
  deliverables       Deliverable[]
  approvals          MilestoneApproval[]

  @@unique([id, clientRelationshipId])
  @@index([clientRelationshipId])
  @@index([projectId])
  @@map("milestones")
}

model Deliverable {
  id                   String                @id @default(cuid())
  clientRelationshipId String
  projectId            String?
  milestoneId          String?
  label                String
  url                  String?
  type                 DeliverableType       @default(LINK)
  notes                String?
  visibility           DeliverableVisibility @default(CLIENT)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  clientRelationship ClientRelationship @relation(fields: [clientRelationshipId], references: [id], onDelete: Cascade)
  project            Project?           @relation(fields: [projectId, clientRelationshipId], references: [id, clientRelationshipId], onDelete: Restrict)
  milestone          Milestone?         @relation(fields: [milestoneId, clientRelationshipId], references: [id, clientRelationshipId], onDelete: Restrict)

  @@index([clientRelationshipId])
  @@index([projectId])
  @@index([milestoneId])
  @@map("deliverables")
}

model MilestoneApproval {
  id                   String                  @id @default(cuid())
  milestoneId          String
  clientRelationshipId String
  actorClerkUserId     String
  actorName            String?
  action               MilestoneApprovalAction
  note                 String?
  createdAt            DateTime                @default(now())

  milestone Milestone @relation(fields: [milestoneId, clientRelationshipId], references: [id, clientRelationshipId], onDelete: Cascade)

  @@index([milestoneId])
  @@map("milestone_approvals")
}

model Contract {
  id                        String         @id @default(cuid())
  clientRelationshipId      String
  projectId                 String?
  contractTemplateVersionId String?
  fieldValues               Json?
  status                    ContractStatus @default(DRAFT)
  signerClerkUserId         String?
  signerEmail               String?
  docusignEnvelopeId        String?
  docusignStatus            String?
  s3Key                     String?
  s3Bucket                  String?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  clientRelationship ClientRelationship       @relation(fields: [clientRelationshipId], references: [id], onDelete: Cascade)
  templateVersion    ContractTemplateVersion? @relation(fields: [contractTemplateVersionId], references: [id])

  @@unique([id, clientRelationshipId])
  @@index([clientRelationshipId])
  @@index([contractTemplateVersionId])
  @@map("contracts")
}
