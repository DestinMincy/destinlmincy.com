{
  "name": "destinlmincy-site",
  "version": "0.1.0",
  "private": true,
  "description": "destinlmincy.com: public site, blog, admin client hub, and client portal for Destin L. Mincy's software and AI agency",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "tsx --test --experimental-test-module-mocks \"__tests__/**/*.test.ts\" lib/client-work/validation.test.ts lib/relationships/validation.test.ts",
    "test:integration": "tsx --test lib/client-work/queries.integration.test.ts lib/docusign/workflow.integration.test.ts",
    "test:e2e": "playwright test tests/e2e/unit05.spec.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/docusign-esign": "^5.19.9",
    "@types/node": "25.9.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.2.3",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1129.0",
    "@aws-sdk/s3-request-presigner": "^3.1129.0",
    "@clerk/nextjs": "^7.5.12",
    "@fontsource-variable/hanken-grotesk": "^5.2.8",
    "@fontsource/zilla-slab": "^5.2.8",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-pdf/renderer": "^4.9.0",
    "docusign-esign": "^10.0.0",
    "gray-matter": "^4.0.3",
    "next": "^16.2.9",
    "pg": "^8.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.3"
  }
}
