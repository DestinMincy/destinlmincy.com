{
  "name": "destinlmincy-site",
  "version": "0.1.0",
  "private": true,
  "description": "destinlmincy.com marketing site and client relationship OS",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "tsx --test lib/client-work/validation.test.ts",
    "test:integration": "tsx --test lib/client-work/queries.integration.test.ts",
    "test:e2e": "playwright test tests/e2e/unit05.spec.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "legacy:build": "eleventy",
    "legacy:start": "eleventy --serve --watch",
    "clean": "rimraf _site",
    "legacy:deploy:s3": "aws s3 sync _site/ s3://destinlmincy.com --delete --cache-control \"public, max-age=300\"",
    "legacy:deploy:invalidate": "aws cloudfront create-invalidation --distribution-id E21OST0SP78GLD --paths \"/*\"",
    "legacy:deploy": "npm run legacy:build && npm run legacy:deploy:s3 && npm run legacy:deploy:invalidate"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "prisma": "^7.8.0",
    "rimraf": "^5.0.5",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.12",
    "@fontsource-variable/hanken-grotesk": "^5.2.8",
    "@fontsource/zilla-slab": "^5.2.8",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "gray-matter": "^4.0.3",
    "next": "^16.2.9",
    "pg": "^8.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.3"
  }
}
