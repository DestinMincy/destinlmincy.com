{
  "name": "destinlmincy-site",
  "version": "0.1.0",
  "private": true,
  "description": "destinlmincy.com — marketing site for the agency",
  "scripts": {
    "build": "eleventy",
    "start": "eleventy --serve --watch",
    "clean": "rimraf _site",
    "deploy:s3": "aws s3 sync _site/ s3://destinlmincy.com --delete --cache-control \"public, max-age=300\"",
    "deploy:invalidate": "aws cloudfront create-invalidation --distribution-id E21OST0SP78GLD --paths \"/*\"",
    "deploy": "npm run build && npm run deploy:s3 && npm run deploy:invalidate"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "rimraf": "^5.0.5"
  }
}
