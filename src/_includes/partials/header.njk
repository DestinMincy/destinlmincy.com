<a href="#main" class="skip-link">Skip to content</a>

<header class="site-header" role="banner">
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label="{{ site.name }} — Home">
      <span class="brand__mark" aria-hidden="true">
        <img src="/img/logo.svg" alt="" width="36" height="36" />
      </span>
      <span class="brand__text">{{ site.name }}</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <button class="site-nav__toggle" aria-expanded="false" aria-controls="primary-nav" type="button">
        <span class="visually-hidden">Menu</span>
        <span class="site-nav__icon" aria-hidden="true"></span>
      </button>

      <ul id="primary-nav" class="site-nav__list">
        <li><a href="/about/" {% if page.url == "/about/" %}aria-current="page"{% endif %}>About</a></li>
        <li><a href="/services/" {% if page.url == "/services/" %}aria-current="page"{% endif %}>Services</a></li>
        <li><a href="/work/" {% if page.url.startsWith("/work") %}aria-current="page"{% endif %}>Work</a></li>
        <li><a class="cta-link" href="/contact/" {% if page.url == "/contact/" %}aria-current="page"{% endif %}>Contact</a></li>
      </ul>
    </nav>
  </div>
</header>
