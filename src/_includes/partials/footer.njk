<footer class="site-footer" role="contentinfo">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <span class="brand__text">{{ site.company }}</span>
      <p class="site-footer__tagline">{{ site.tagline }}</p>
      <p class="site-footer__location">{{ site.location }}</p>
    </div>

    <nav class="site-footer__nav" aria-label="Footer">
      <ul>
        <li><a href="/about/">About</a></li>
        <li><a href="/services/">Services</a></li>
        <li><a href="/work/">Work</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </nav>

    <div class="site-footer__meta">
      <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>

      {% if site.github or site.linkedin or site.twitter %}
      <ul class="site-footer__social" aria-label="Social links">
        {% if site.github %}
        <li>
          <a href="{{ site.github }}" rel="noopener me" target="_blank" aria-label="GitHub">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.51-1.47.11-3.06 0 0 .97-.31 3.18 1.18A11.04 11.04 0 0 1 12 6.8c.98.01 1.97.13 2.89.39 2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.24 2.77.12 3.06.74.81 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.27 5.68.41.36.78 1.06.78 2.14 0 1.54-.01 2.79-.01 3.17 0 .31.21.68.8.56C20.22 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/>
            </svg>
            <span class="visually-hidden">GitHub</span>
          </a>
        </li>
        {% endif %}
        {% if site.linkedin %}
        <li>
          <a href="{{ site.linkedin }}" rel="noopener me" target="_blank" aria-label="LinkedIn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.95v5.66H9.36V9h3.41v1.56h.05c.47-.89 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/>
            </svg>
            <span class="visually-hidden">LinkedIn</span>
          </a>
        </li>
        {% endif %}
        {% if site.twitter %}
        <li>
          <a href="{{ site.twitter }}" rel="noopener me" target="_blank" aria-label="Twitter / X">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
            <span class="visually-hidden">Twitter / X</span>
          </a>
        </li>
        {% endif %}
      </ul>
      {% endif %}

      <p>&copy; {{ "" | year }} {{ site.company }}. All rights reserved.</p>
    </div>
  </div>
</footer>
